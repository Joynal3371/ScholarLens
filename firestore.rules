rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'provider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'provider', 'orcidId', 'photoURL', 'scholarUrl', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.provider is string
        && (data.provider == 'google' || data.provider == 'orcid')
        && (!('orcidId' in data) || (data.orcidId is string && data.orcidId.size() <= 40))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 150000))
        && (!('scholarUrl' in data) || (data.scholarUrl is string && data.scholarUrl.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExportRecord(data) {
      return data.keys().hasAll(['ownerId', 'scholarName', 'exportType', 'targetName', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'scholarName', 'exportType', 'targetName', 'createdAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.scholarName is string
        && data.scholarName.size() >= 1
        && data.scholarName.size() <= 160
        && data.exportType is string
        && (data.exportType == 'pdf' || data.exportType == 'png')
        && data.targetName is string
        && data.targetName.size() >= 1
        && data.targetName.size() <= 160
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'orcidId', 'photoURL', 'scholarUrl', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /exports/{exportId} {
      allow get: if isSignedIn() && isValidId(exportId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(exportId)
        && isValidExportRecord(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
    function isBridgeWorker() {
      return isSignedIn() && request.auth.uid == 'WtRvyLbLwPgzKj6ZIAGbxHoM0bJ2';
    }

    function isValidScholarBridgeDoc(data) {
      return data.keys().hasAll(['userId', 'status', 'payloadJson', 'updatedAtMs'])
        && data.keys().hasOnly(['userId', 'queryName', 'status', 'payloadJson', 'updatedAtMs'])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.status is string
        && (data.status == 'pending' || data.status == 'ready' || data.status == 'error')
        && (!('queryName' in data) || (data.queryName is string && data.queryName.size() <= 160))
        && data.payloadJson is string
        && data.payloadJson.size() <= 900000
        && data.updatedAtMs is int;
    }

    match /scholarBridge/{scholarId} {
      allow get, list: if isBridgeWorker();
      allow create, update: if isBridgeWorker()
        && isValidId(scholarId)
        && isValidScholarBridgeDoc(incoming());
      allow delete: if false;
    }
  }
}
