{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated researcher user profile for Google or ORCID sign-in.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user identifier matching request.auth.uid.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the researcher.",
          "minLength": 1,
          "maxLength": 120
        },
        "provider": {
          "type": "string",
          "description": "Authentication provider used (google or orcid).",
          "enum": ["google", "orcid"]
        },
        "orcidId": {
          "type": "string",
          "description": "Optional ORCID identifier.",
          "minLength": 0,
          "maxLength": 40
        },
        "photoURL": {
          "type": "string",
          "description": "User profile picture URL or data URI.",
          "minLength": 0,
          "maxLength": 150000
        },
        "scholarUrl": {
          "type": "string",
          "description": "Mandatory Google Scholar profile link for the researcher.",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was last updated."
        }
      },
      "required": ["uid", "displayName", "provider", "createdAt", "updatedAt"]
    },
    "ExportRecord": {
      "title": "ExportRecord",
      "description": "Record of a PDF or PNG export generated by an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the user who generated the export.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "scholarName": {
          "type": "string",
          "description": "Name of the analyzed researcher profile.",
          "minLength": 1,
          "maxLength": 160
        },
        "exportType": {
          "type": "string",
          "description": "Type of export generated (pdf or png).",
          "enum": ["pdf", "png"]
        },
        "targetName": {
          "type": "string",
          "description": "Name of the exported chart or report.",
          "minLength": 1,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the export."
        }
      },
      "required": ["ownerId", "scholarName", "exportType", "targetName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public/non-PII researcher user profile keyed by user UID."
    },
    "/exports/{exportId}": {
      "schema": {
        "$ref": "#/entities/ExportRecord"
      },
      "description": "Stores export activity records owned by authenticated researchers."
    }
  }
}
